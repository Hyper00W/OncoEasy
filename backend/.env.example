# OncoEasy backend configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- Core (always required) ---
PORT=3000
# development | test | production
NODE_ENV=development
# Comma-separated list of allowed browser origins. Wildcard "*" is FORBIDDEN in production.
CORS_ORIGIN=http://localhost:5173
# PostgreSQL connection string (e.g. Neon). Backend-only secret.
# PRODUCTION: use a dedicated managed-PostgreSQL URL with TLS; localhost URLs are rejected at startup in production.
# Migration command in production: `npm run db:migrate:deploy` (never `migrate dev` / `db push` / `reset`). See docs/database-operations.md.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# --- JWT authentication (backend-only secrets) ---
# Use unique random values, at least 32 characters long in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Upload size limits (defaults shown) ---
PRESCRIPTION_MAX_FILE_SIZE_BYTES=10485760
DELIVERY_PROOF_MAX_FILE_SIZE_BYTES=10485760

# --- Private object storage ---
# in-memory (development/test only; FORBIDDEN in production) | s3 (AWS S3) | s3-compatible (MinIO, Cloudflare R2, etc.)
STORAGE_PROVIDER=in-memory
# Required when STORAGE_PROVIDER is s3 or s3-compatible:
#STORAGE_BUCKET=
#STORAGE_REGION=
#STORAGE_ACCESS_KEY_ID=
#STORAGE_SECRET_ACCESS_KEY=
# Required for s3-compatible providers (endpoint URL of the S3 API); leave unset for AWS S3:
#STORAGE_ENDPOINT=
# Set to true only for endpoint-based providers that require path-style addressing:
#STORAGE_FORCE_PATH_STYLE=false
# Signed private-access URL lifetime in seconds (default 300, matching current workflows).
#STORAGE_SIGNED_URL_EXPIRY_SECONDS=300

# --- WhatsApp Business (Meta Cloud API) ---
# Keep WHATSAPP_ENABLED=false in development/test: sends then fail fast with WHATSAPP_DISABLED
# instead of silently mocking. Set it to true ONLY where real credentials exist.
WHATSAPP_ENABLED=false
# Required when WHATSAPP_ENABLED=true (backend-only secrets; base URL is normally https://graph.facebook.com):
#WHATSAPP_API_BASE_URL=
#WHATSAPP_API_VERSION=
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_ACCESS_TOKEN=

# --- SMS fallback channel (generic HTTP gateway) ---
# Secondary channel: used ONLY when a notification opts in to SMS fallback and
# WhatsApp did not succeed. Keep SMS_ENABLED=false in development/test: sends
# then fail fast with SMS_DISABLED instead of silently mocking. Set it to true
# ONLY where real credentials exist.
SMS_ENABLED=false
# Required when SMS_ENABLED=true (backend-only secret). The adapter POSTs JSON
# {"to","text","from"} with "Authorization: Bearer <SMS_API_KEY>" to the exact
# base URL (include any gateway path), and reads an optional reference from
# messageId/message_id/id/sid.
#SMS_API_BASE_URL=
#SMS_API_KEY=
# Optional transactional sender ID/alpha sender, included as the "from" field:
#SMS_SENDER_ID=

# --- Payment gateway (Razorpay) ---
# Keep PAYMENT_GATEWAY_ENABLED=false in development/test: prepaid initiation keeps the
# legacy pending-integration marker (PENDING_PROVIDER_INTEGRATION) and no checkout data
# is returned. Set it to true ONLY where real credentials exist.
PAYMENT_GATEWAY_ENABLED=false
# Required when PAYMENT_GATEWAY_ENABLED=true. The KEY ID is the ONLY value exposed to
# the frontend (via the checkout payload); the KEY SECRET and WEBHOOK SECRET are
# backend-only secrets that must never appear in logs, errors, or responses.
#PAYMENT_GATEWAY_KEY_ID=
#PAYMENT_GATEWAY_KEY_SECRET=
# Optional. When set (and the gateway is enabled) the webhook endpoint at
# POST /api/v1/payments/webhook becomes active and verifies signatures with it.
#PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- Transactional email (generic HTTP vendor) ---
# Keep EMAIL_ENABLED=false in development/test: sends then fail fast with EMAIL_DISABLED
# instead of silently mocking. Set it to true ONLY where real credentials exist.
EMAIL_ENABLED=false
# Required when EMAIL_ENABLED=true (backend-only secret). The adapter POSTs JSON
# {"from","to","subject","text","html"} with "Authorization: Bearer <EMAIL_API_KEY>"
# to the exact base URL (include any vendor path), and reads an optional reference
# from messageId/message_id/id.
#EMAIL_API_BASE_URL=
#EMAIL_API_KEY=
# Required when EMAIL_ENABLED=true: verified sender address, e.g. no-reply@oncoeasy.example
#EMAIL_FROM_ADDRESS=
# Optional friendly sender name shown in mail clients:
#EMAIL_FROM_NAME=

# --- Deferred provider integrations (Phase 3 later steps; DO NOT configure yet) ---
